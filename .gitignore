# Radiance .gitignore
# Optimized for Python/ComfyUI Custom Node Development

# --- Python ---
__pycache__/
*.py[cod]
*$py.class

# Distribution / Packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
node_modules/

# Virtual Environments
venv/
.venv/
env/
ENV/

# --- Testing ---
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
htmlcov/
.pytest_cache/
.ruff_cache/
.hypothesis/

# --- IDEs / Editors ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- ComfyUI Specific ---
# Exclude model weights or large local assets if placed in node dir
models/
checkpoints/
loras/
*.ckpt
*.safetensors
*.pt
*.pth
*.bin

# --- Logs & Temp ---
*.log
*.map
*.tmp
*.temp
local_settings.py
db.sqlite3
core/*.db
/output/
/temp/
/temp_pwn/
/tmp_qa_test/
/tmp_qa_output/
workflows/.versions/
workflows/GENERAL/dashboard_*.rad
workflows/GENERAL/test_*_v*.rad

# --- Security (Double Check) ---
.env
.env.*
secrets.json
*.pem
*.key
*.docx
*.bak
scratch/
# EOF
docs/
!docs/
!docs/*.md
!docs/*.html
!docs/*.css
!docs/*.js
!docs/built-in-nodes/
!docs/built-in-nodes/*.md
!docs/site/
!docs/site/*.html
!docs/site/*.css
!docs/site/*.js

# Local dev-server artifacts
artifacts/

# ── Radiance user / project data (keep local; not shipped in the package) ──
workflows/*.rad
workflows/**/*.rad
!workflows/official/
!workflows/official/**
workflows/_assets_bins.json
workflows/.asset_thumbs/
workflows/**/.shot_status.json
workflows/**/.review_notes.json
gizmos/*.gizmo

# Internal dev artifacts — must not ship to the registry (audit 2026-07)
bug_report_reply_draft.md
PACKAGE_REVIEW.md
.codex-backup-*/
.agents/

# Session scratch from the 2026-07 audit — never part of the source tree
_audit_tmp/
_to_delete/
.phase3-dist/
.phase3-dist-final/
batch01.patch
batch2.patch

# Caches, build output and local virtualenvs — never part of the source tree
.phase3-venv/

# ── Node output written into the source tree (cleanup 2026-08) ──
# Two path widgets defaulted to bare relative strings, so running those nodes
# (or the tests that exercise them) wrote into the process working directory.
# The defaults are now anchored to ComfyUI's output/ folder, but keep these
# ignored so a stale checkout cannot commit them.
grading/
preview/
# A test that stubs folder_paths with a bare MagicMock once made models_dir a
# truthy Mock; joining it produced a literal directory of that name.
MagicMock/

# ── Internal contributor docs — local reference, not published ──
# Written 2026-08-16. Deliberately kept out of the repo: they describe repo
# internals, in-flight debt and failure history rather than how to use the
# package. Delete these two lines to publish them.
docs/architecture.md
docs/developer.md
